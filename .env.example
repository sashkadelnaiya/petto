# Public URL of the backend (used by browser for Socket.IO and avatars)
# Replace with your VPS IP or domain
NEXT_PUBLIC_BACKEND_URL=http://YOUR_VPS_IP:3000

# Yandex Maps API key (get at https://developer.tech.yandex.ru/)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# JWT secrets (change in production!)
JWT_ACCESS_SECRET=access_secret
JWT_REFRESH_SECRET=refresh_secret

# Set to "true" if using HTTPS, "false" for plain HTTP
COOKIE_SECURE=false
